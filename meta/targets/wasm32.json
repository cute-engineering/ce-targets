{
    "$schema": "https://schemas.cute.engineering/stable/cutekit.manifest.target.v1",
    "id": "wasm32",
    "type": "target",
    "props": {
        "toolchain": "clang",
        "arch": "unknown",
        "sys": "wasm",
        "abi": "unknown",
        "bits": "32",
        "freestanding": false,
        "host": false,
        "sys-encoding": "utf8",
        "sys-line-ending": "lf",
        "sys-path-separator": "slash",
        "sys-terminal": false
    },
    "tools": {
        "cc": {
            "cmd": "{shell.env('CC', shell.latest('clang'))}",
            "args": [
                "--target=wasm32-unknown-wasi"
            ]
        },
        "cxx": {
            "cmd": "{shell.env('CXX', shell.latest('clang++'))}",
            "args": [
                "--target=wasm32-unknown-wasi",
                "-fno-exceptions",
                "-fno-rtti"
            ]
        },
        "ld": {
            "cmd": "{shell.env('LD', shell.latest('wasm-ld'))}",
            "args": [
                "--no-entry",
                "--export-all"
            ]
        },
        "ar": {
            "cmd": "{shell.env('AR', shell.latest('llvm-ar'))}",
            "args": [
                "rcs"
            ]
        },
        "as": {
            "cmd": "nasm",
            "args": [
                "-f",
                "elf64"
            ]
        }
    }
}
